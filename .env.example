# --- Supabase --------------------------------------------------------
# Supabase-Projekt-URL und Keys: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# NUR serverseitig verwenden, niemals mit NEXT_PUBLIC_ Prefix versehen!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Twilio (SMS & WhatsApp) -----------------------------------------
# Twilio Console: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Twilio SMS-Absendernummer (im Twilio-Konto gekauft), Format +49...
TWILIO_SMS_NUMBER=+1xxxxxxxxxx
# Twilio WhatsApp-Absendernummer (Sandbox zum Testen oder freigeschaltete
# WhatsApp Business-Nummer), Format +1415xxxxxxx
TWILIO_WHATSAPP_NUMBER=+14155238886

# --- App ---------------------------------------------------------------
# Öffentliche Basis-URL der App (für Links in SMS/WhatsApp-Nachrichten)
NEXT_PUBLIC_APP_URL=http://localhost:3000
